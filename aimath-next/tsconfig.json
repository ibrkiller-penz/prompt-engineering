{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@site/*": ["./src/student/*", "./src/teacher/*"],
      "@shared/*": ["./src/shared/*"],
      "@data/*": ["./data/*"],
      "@content/*": ["../content/aimath/*"],
      "@legacy/*": ["../src/aimath/*"]
    }
  },
  "include": ["src", "tests"]
}
