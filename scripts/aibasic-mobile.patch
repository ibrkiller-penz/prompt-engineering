+    const card = el(`<div class="qz reveal"><div class="qh">문제 ${idx + 1}</div>${q.passage ? `<div class="passage">${q.passage}</div>` : ''}<div class="q">${q.q}</div></div>`);
+    card.appendChild(question(q, async (ok) => {
+      if (ok) { correct++; combo++; maxCombo = Math.max(maxCombo, combo); addXP(practice ? 2 : 6 + Math.min(combo, 4)); } else combo = 0;
