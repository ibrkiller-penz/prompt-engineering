{
  "_설명": "개인정보로 보이는 말을 찾는 정규식. 찾으면 경고만 하고, 입력한 글은 어디에도 보내거나 저장하지 않는다.",
  "message": "이름·학교·연락처 같은 개인정보는 AI에게 말하지 않아요. 지워 볼까요?",
  "patterns": [
    { "label": "학교 이름", "regex": "[가-힣]{2,}(초등학교|중학교|고등학교|초교|중교|고교)" },
    { "label": "학년·반", "regex": "\\d\\s*학년\\s*\\d+\\s*반" },
    { "label": "전화번호", "regex": "0\\d{1,2}[-.\\s]?\\d{3,4}[-.\\s]?\\d{4}" },
    { "label": "이메일", "regex": "[\\w.+-]+@[\\w-]+\\.[\\w.]+" },
    { "label": "주소", "regex": "[가-힣\\d]+(로|길)\\s?\\d+(-\\d+)?(번길)?" },
    { "label": "이름", "regex": "(내|제|나의) ?이름은" }
  ]
}
