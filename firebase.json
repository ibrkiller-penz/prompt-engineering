{
  "hosting": {
    "site": "penedu",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "science/**"
    ],
    "rewrites": [
      {
        "source": "/science",
        "destination": "/moved-science.html"
      },
      {
        "source": "/science/**",
        "destination": "/moved-science.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}